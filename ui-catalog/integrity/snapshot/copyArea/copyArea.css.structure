    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    /* the area and its button side by side; the failure message below both; code and content fill the width */
    .ui-copy-area { position:relative; display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-areas:"body action" "message message"; box-sizing:border-box; min-inline-size:0; max-inline-size:100%; text-align:start; }
    .ui-copy-area-code, .ui-copy-area-content { inline-size:100%; }
    .ui-copy-area-body { grid-area:body; margin:0; overflow:auto; min-inline-size:0; box-sizing:border-box; }
    pre.ui-copy-area-body { white-space:pre; }
    /* plain text: the text and the button together on one line (inside running text; a long text wraps, the button stays
       beside it); the failure message on its own line */
    .ui-copy-area-plain { display:inline-flex; align-items:center; vertical-align:middle; }
    .ui-copy-area-plain:has(> .ui-copy-area-message:not([hidden])) { flex-wrap:wrap; }
    .ui-copy-area-plain .ui-copy-area-message { flex:1 0 100%; }
    .ui-copy-area-text { grid-area:body; flex:0 1 auto; min-inline-size:0; overflow-wrap:anywhere; }
    .ui-copy-area-action { grid-area:action; display:inline-flex; align-self:start; }
    .ui-copy-area-plain .ui-copy-area-action { align-self:center; }
    .ui-copy-area-message { grid-area:message; display:block; }
    .ui-copy-area-message[hidden] { display:none; }
    .ui-copy-area-fallback { overflow-wrap:anywhere; user-select:all; }
    .ui-copy-area-line-numbers code { counter-reset:ui-copy-area-line; }
    .ui-copy-area-line::before { counter-increment:ui-copy-area-line; content:counter(ui-copy-area-line); display:inline-block; text-align:end; user-select:none; }
    .ui-copy-area-body:focus-visible { outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    .ui-copy-area-visually-hidden { position:absolute; inline-size:1px; block-size:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
    .ui-copy-area-staging { position:absolute; inline-size:1px; block-size:1px; overflow:hidden; clip-path:inset(50%); }
}
