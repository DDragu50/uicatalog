    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    .ui-app-header { min-inline-size:0; }
    /* pinned: the component writes --ui-app-header-space / -left / -width (measured) */
    .ui-app-header-pinned { min-block-size:var(--ui-app-header-space,auto); }
    .ui-app-header-inner { position:relative; display:block; }
    .ui-app-header-pinned .ui-app-header-inner { position:fixed; inset-block-start:0; left:var(--ui-app-header-left,0); inline-size:var(--ui-app-header-width,100%); z-index:30; }
    .ui-app-header-pinned .ui-app-header-level:not(.ui-app-header-sticky) { display:none; }
    .ui-app-header-skip { position:absolute; z-index:31; transform:translateY(-200%); }
    .ui-app-header-skip:focus { transform:none; outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    .ui-app-header-visually-hidden { position:absolute; inline-size:1px; block-size:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
    .ui-app-header-top { display:flex; flex-wrap:wrap; align-items:center; }
    .ui-app-header-start, .ui-app-header-end { display:flex; flex:0 0 auto; align-items:center; }
    .ui-app-header-end { margin-inline-start:auto; }
    .ui-app-header-end:empty { display:none; }
    /* no empty slot (and gap) after the search when nothing is configured at the end */
    .ui-app-header-middle { display:flex; align-items:center; min-inline-size:0; }
    .ui-app-header-level[hidden] { display:none; }
    .ui-app-header-brand { display:inline-flex; align-items:center; color:inherit; text-decoration:none; }
    .ui-app-header-brand:focus-visible, .ui-app-header-icon-link:focus-visible { outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    .ui-app-header-logo { display:block; inline-size:auto; object-fit:contain; }
    .ui-app-header-name { white-space:nowrap; }
    .ui-app-header-environment { display:inline-flex; align-items:center; white-space:nowrap; }
    .ui-app-header-search-host { min-inline-size:0; }
    .ui-app-header-search-host .ui-search-box { margin:0; }
    .ui-app-header-icon-link { display:inline-flex; align-items:center; justify-content:center; color:inherit; text-decoration:none; }
    /* below 48rem: the name hides when there is a logo, the user's name and role hide (kept for screen readers);
       the middle area (search) moves to its own row */
    @media (max-width:48rem) {
        .ui-app-header-logo + .ui-app-header-name { display:none; }
        .ui-app-header-user-host .ui-badge-text { position:absolute; inline-size:1px; block-size:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
        .ui-app-header-middle { order:3; flex-basis:100%; flex-wrap:wrap; }
        .ui-app-header-search-host { max-inline-size:none; }
    }
}
