    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    .ui-select-wrapper { display:grid; min-inline-size:0; max-inline-size:var(--percentage-full); }
    .ui-select-label { display:flex; align-items:center; margin:0; }
    .ui-select-view-value { margin:0; }
    .ui-select-visually-hidden { position:absolute; inline-size:1px; block-size:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }

    /* Shared field (native select and custom trigger) */
    .ui-select-control { position:relative; display:flex; min-inline-size:0; }
    .ui-select-native-field, .ui-select-trigger { box-sizing:border-box; inline-size:100%; min-inline-size:0; }
    .ui-select-native-field:not([multiple]), .ui-select-trigger { -webkit-appearance:none; appearance:none; cursor:pointer; }
    .ui-select-native-field:focus, .ui-select-trigger:focus { outline:0; }
    .ui-select-native-field:focus-visible, .ui-select-trigger:focus-visible { outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    .ui-select-native-field:disabled, .ui-select-trigger:disabled { cursor:not-allowed; }

    .ui-select-chevron { position:absolute; inset-block-start:50%; transform:translateY(-75%) rotate(45deg); pointer-events:none; }

    /* Custom trigger */
    .ui-select-trigger { position:relative; display:flex; align-items:center; text-align:start; }
    .ui-select-value { flex:0 1 auto; min-inline-size:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
    .ui-select-more { flex:0 0 auto; }
    .ui-select-more:empty { display:none; }

    /* Custom popover and listbox (top layer); position and size set by the component */
    .ui-select-popup { position:fixed; inset:auto; margin:0;
      inset-inline-start:var(--ui-select-popup-left,0); inset-block-start:var(--ui-select-popup-top,0); inline-size:var(--ui-select-popup-width,auto);
      max-block-size:var(--ui-select-popup-max-height,var(--ui-select-popup-limit)); overflow:hidden; box-sizing:border-box; }
    .ui-select-popup:popover-open, .ui-select-popup-open { display:flex; flex-direction:column; }
    .ui-select-popup:not(:popover-open):not(.ui-select-popup-open) { display:none; }
    .ui-select-search { box-sizing:border-box; flex:0 0 auto; inline-size:100%; }
    .ui-select-search:focus-visible { outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    .ui-select-listbox { flex:1 1 auto; min-block-size:0; overflow-y:auto; outline:0; }
    .ui-select-option { display:flex; align-items:center; cursor:pointer; }
    .ui-select-option[hidden], .ui-select-group[hidden] { display:none; }
    .ui-select-option-active { outline:var(--focus-outline); outline-offset:calc(-1 * var(--border-thin)); }
    .ui-select-option[aria-disabled="true"] { cursor:not-allowed; }
    .ui-select-check { flex:0 0 auto; }
    .ui-select-option[aria-selected="true"] .ui-select-check { transform:rotate(45deg) translateY(-15%); }

    /* Label on the left: labelPosition START, or INHERIT inside an element with the class ui-labels-start.
       Applies only while the nearest container (e.g. Form, ContentGroup, CollapsiblePanel) is at least 36rem wide;
       narrower, the label returns on top. 36rem is a literal because custom properties cannot be used in container queries.
       Label column width: --form-label-width (design-system.css); gap between label and field: --gap-toolbar. */
    @container (min-width:36rem) {
        :is(.ui-labels-start .ui-select-wrapper:not(.ui-select-label-top), .ui-select-wrapper.ui-select-label-start) { grid-template-columns:var(--form-label-width) minmax(0,1fr); column-gap:var(--gap-toolbar); }
        /* label on the left with width SMALL / MEDIUM / LARGE: the row keeps the full width and the option sizes the field
           column (a share of the row, never more than the room beside the label) */
        :is(.ui-labels-start .ui-select-wrapper:not(.ui-select-label-top), .ui-select-wrapper.ui-select-label-start).ui-select-width-small { inline-size:var(--percentage-full); grid-template-columns:var(--form-label-width) minmax(0,min(var(--percentage-s), 100% - var(--form-label-width) - var(--gap-toolbar))); }
        :is(.ui-labels-start .ui-select-wrapper:not(.ui-select-label-top), .ui-select-wrapper.ui-select-label-start).ui-select-width-medium { inline-size:var(--percentage-full); grid-template-columns:var(--form-label-width) minmax(0,min(var(--percentage-m), 100% - var(--form-label-width) - var(--gap-toolbar))); }
        :is(.ui-labels-start .ui-select-wrapper:not(.ui-select-label-top), .ui-select-wrapper.ui-select-label-start).ui-select-width-large { inline-size:var(--percentage-full); grid-template-columns:var(--form-label-width) minmax(0,min(var(--percentage-l), 100% - var(--form-label-width) - var(--gap-toolbar))); }
        :is(.ui-labels-start .ui-select-wrapper:not(.ui-select-label-top), .ui-select-wrapper.ui-select-label-start) > * { grid-column:2; }
        :is(.ui-labels-start .ui-select-wrapper:not(.ui-select-label-top), .ui-select-wrapper.ui-select-label-start) > .ui-select-label { grid-column:1; float:inline-start; margin:0; align-self:center; }
    }
}
