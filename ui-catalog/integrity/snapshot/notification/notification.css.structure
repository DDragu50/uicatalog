    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    /* geometry follows the helpers of part 2; the indicator's proportions are geometric */
    .ui-notification { position:relative; display:inline-flex; flex:0 0 auto; align-items:center; box-sizing:border-box;
      block-size:var(--ui-notification-size); vertical-align:middle; }
    .ui-notification-shape { display:inline-flex; flex:0 0 auto; align-items:center; justify-content:center; box-sizing:border-box;
      min-inline-size:var(--ui-notification-size); block-size:var(--ui-notification-size); }
    .ui-notification-circle > .ui-notification-shape { inline-size:var(--ui-notification-size); }
    .ui-notification-image { inline-size:100%; block-size:100%; object-fit:cover; }
    .ui-notification-text { white-space:nowrap; }

    button.ui-notification { cursor:pointer; }
    button.ui-notification:focus-visible { outline:0; }
    button.ui-notification:focus-visible > .ui-notification-shape { outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    button.ui-notification:disabled { cursor:not-allowed; }

    /* Indicator */
    .ui-notification-indicator { position:absolute; display:inline-flex; align-items:center; justify-content:center; box-sizing:border-box;
      min-inline-size:var(--ui-notification-indicator-size); block-size:var(--ui-notification-indicator-size); padding:0;
      font-size:calc(var(--ui-notification-indicator-size) * 0.62); line-height:1; white-space:nowrap; pointer-events:none; }
    .ui-notification-pill { padding:0 calc(var(--ui-notification-indicator-size) * 0.3); }
    .ui-notification-indicator-dot { min-inline-size:0; inline-size:calc(var(--ui-notification-indicator-size) * 0.6); block-size:calc(var(--ui-notification-indicator-size) * 0.6); }

    /* Corners: logical insets (mirrored automatically in right-to-left), overlapping by a third of the indicator size,
       measured from inside the shape's thin border (as when the element itself carried the border) */
    .ui-notification-corner-top-right { inset-block-start:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); inset-inline-end:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); }
    .ui-notification-corner-top-left { inset-block-start:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); inset-inline-start:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); }
    .ui-notification-corner-bottom-right { inset-block-end:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); inset-inline-end:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); }
    .ui-notification-corner-bottom-left { inset-block-end:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); inset-inline-start:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); }
    /* A pill at a right corner is part of the layout: it starts where a round indicator starts (two thirds of the indicator
       size, plus the border, inside the shape's end) and grows away from the shape; its negative end margin cancels the usual one-third
       overhang, so the notification is wider only by the pill's extra length (a round indicator changes nothing). */
    .ui-notification-pill:is(.ui-notification-corner-top-right, .ui-notification-corner-bottom-right) { position:relative; flex:0 0 auto; inset-inline-end:auto; margin-inline-start:calc(-1 * var(--border-thin) - var(--ui-notification-indicator-size) * 0.67); margin-inline-end:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); }
    .ui-notification-pill.ui-notification-corner-top-right { align-self:flex-start; inset-block-start:calc(var(--border-thin) - var(--ui-notification-indicator-size) * 0.33); }
    .ui-notification-pill.ui-notification-corner-bottom-right { align-self:flex-end; inset-block-start:calc(var(--ui-notification-indicator-size) * 0.33 - var(--border-thin)); inset-block-end:auto; }

    /* Dot shapes */
    .ui-notification-shape-diamond { rotate:45deg; scale:0.8; }
    .ui-notification-shape-triangle { clip-path:polygon(50% 0, 100% 100%, 0 100%); inline-size:calc(var(--ui-notification-indicator-size) * 0.75); block-size:calc(var(--ui-notification-indicator-size) * 0.7); }

    @media (prefers-reduced-motion:reduce) { button.ui-notification { transition:none; } }
}
