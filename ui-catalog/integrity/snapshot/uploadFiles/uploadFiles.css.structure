    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    .ui-upload-files { display:grid; min-inline-size:0; max-inline-size:var(--percentage-full); }
    .ui-upload-files-label { display:flex; align-items:center; flex-wrap:wrap; }
    .ui-upload-files-control { display:grid; min-inline-size:0; }
    .ui-upload-files-input { display:none; }
    .ui-upload-files-bar { display:flex; align-items:center; }
    .ui-upload-files-dropzone { display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; }
    .ui-upload-files-choose, .ui-upload-files-action { display:inline-flex; }
    .ui-upload-files-action[hidden] { display:none; }

    .ui-upload-files-list { list-style:none; margin:0; padding:0; min-inline-size:0; }
    .ui-upload-files-list[hidden], .ui-upload-files-summary[hidden], .ui-upload-files-error[hidden], .ui-upload-files-reason[hidden] { display:none; }
    .ui-upload-files-item { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; }
    .ui-upload-files-icon { display:flex; align-items:center; justify-content:center; }
    .ui-upload-files-preview { display:block; object-fit:cover; }
    .ui-upload-files-text { display:flex; flex-direction:column; min-inline-size:0; }
    .ui-upload-files-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ui-upload-files-meta { display:flex; flex-wrap:wrap; }
    .ui-upload-files-status:empty { display:none; }
    .ui-upload-files-progress:empty { display:none; }
    .ui-upload-files-actions { display:flex; align-items:center; }

    .ui-upload-files-visually-hidden { position:absolute; inline-size:1px; block-size:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }

    /* Label on the left: labelPosition START, or INHERIT inside an element with the class ui-labels-start.
       Applies only while the nearest container is at least 36rem wide; narrower, the label returns on top.
       36rem is a literal because custom properties cannot be used in container queries.
       Label column width: --form-label-width (design-system.css); gap between label and field: --gap-toolbar. */
    @container (min-width:36rem) {
        :is(.ui-labels-start .ui-upload-files:not(.ui-upload-files-label-top), .ui-upload-files.ui-upload-files-label-start) { grid-template-columns:var(--form-label-width) minmax(0,1fr); column-gap:var(--gap-toolbar); align-items:start; }
        :is(.ui-labels-start .ui-upload-files:not(.ui-upload-files-label-top), .ui-upload-files.ui-upload-files-label-start) > .ui-upload-files-label { min-block-size:var(--control-height); }
    }
}
