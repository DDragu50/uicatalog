    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    .ui-badge { display:inline-flex; align-items:center; max-inline-size:100%; min-inline-size:0; box-sizing:border-box; border:0; background-color:transparent; text-align:start; text-decoration:none; vertical-align:middle; }
    .ui-badge-vertical { flex-direction:column; text-align:center; }
    .ui-badge-notification-host { display:inline-flex; flex:0 0 auto; }
    .ui-badge-text { display:flex; flex-direction:column; min-inline-size:0; }
    .ui-badge-vertical .ui-badge-text { align-items:center; }
    .ui-badge-name, .ui-badge-description { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
    .ui-badge-visually-hidden { position:absolute; inline-size:1px; block-size:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
    .ui-badge-interactive { cursor:pointer; }
    .ui-badge-interactive:focus-visible { outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    @media (prefers-reduced-motion:reduce) { .ui-badge-interactive { transition:none; } }
}
