    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    .ui-action-menu { display:inline-flex; }
    /* position: the component writes --ui-action-menu-top / --ui-action-menu-left (measured) */
    .ui-action-menu-list { position:fixed; inset:auto; margin:0; inset-block-start:var(--ui-action-menu-top,0); inset-inline-start:var(--ui-action-menu-left,0); list-style:none; box-sizing:border-box; }
    .ui-action-menu-list:not(:popover-open):not(.ui-action-menu-open) { display:none; }
    .ui-action-menu-item { display:flex; align-items:center; inline-size:100%; border:0; text-align:start; text-decoration:none; cursor:pointer; box-sizing:border-box; }
    .ui-action-menu-item:hover, .ui-action-menu-item:focus { outline:0; }
    .ui-action-menu-item:focus-visible { outline:var(--focus-outline); outline-offset:calc(-1 * var(--border-thin)); }
    .ui-action-menu-item[aria-disabled="true"] { cursor:not-allowed; }
    .ui-action-menu-icon { display:inline-flex; justify-content:center; flex:0 0 auto; }
    .ui-action-menu-label { flex:1 1 auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .ui-action-menu-separator { block-size:0; }
}
