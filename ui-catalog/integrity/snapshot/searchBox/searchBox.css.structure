    /* ======================================================================
       3. STRUCTURE — do not change
       ====================================================================== */
    .ui-search-box { display:grid; min-inline-size:0; max-inline-size:var(--percentage-full); }
    .ui-search-box-visually-hidden { position:absolute; inline-size:1px; block-size:1px; margin:-1px; padding:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
    .ui-search-box-row { display:flex; align-items:center; min-inline-size:0; }
    .ui-search-box-control { display:flex; flex:1 1 auto; align-items:center; min-inline-size:0; }
    .ui-search-box-control:has(.ui-search-box-input:focus-visible) { outline:var(--focus-outline); outline-offset:var(--focus-offset); }
    .ui-search-box-busy-icon { display:inline-flex; flex:0 0 auto; line-height:1; }
    .ui-search-box-busy-icon[hidden] { display:none; }
    .ui-search-box-width-fit-content .ui-search-box-input { inline-size:auto; }
    .ui-search-box-input { flex:1 1 auto; inline-size:100%; min-inline-size:0; border:0; outline:0; background-color:transparent; -webkit-appearance:none; appearance:none; }
    .ui-search-box-input::-webkit-search-cancel-button, .ui-search-box-input::-webkit-search-decoration { -webkit-appearance:none; appearance:none; }
    .ui-search-box-clear-host { display:inline-flex; flex:0 0 auto; }
    .ui-search-box-clear-host[hidden] { display:none; }
    .ui-search-box-message-host:empty { display:none; }
    .ui-search-box-help[hidden] { display:none; }
    @keyframes ui-search-box-spin { to { transform:rotate(360deg); } }
    @media (prefers-reduced-motion:reduce) { .ui-search-box-busy-icon i { animation:none; } }
    @media (max-width:768px) { .ui-search-box { max-inline-size:100%; } }
    /* Label on the left: labelPosition START, or INHERIT inside an element with the class ui-labels-start.
       Applies only while the nearest container (e.g. Form, ContentGroup, CollapsiblePanel) is at least 36rem wide;
       narrower, the label returns on top. 36rem is a literal because custom properties cannot be used in container queries.
       Label column width: --form-label-width (design-system.css); gap between label and field: --gap-toolbar. */
    @container (min-width:36rem) {
        :is(.ui-labels-start .ui-search-box:not(.ui-search-box-label-top), .ui-search-box.ui-search-box-label-start) { grid-template-columns:var(--form-label-width) minmax(0,1fr); column-gap:var(--gap-toolbar); }
        /* label on the left with width SMALL / MEDIUM / LARGE: the row keeps the full width and the option sizes the field
           column (a share of the row, never more than the room beside the label) */
        :is(.ui-labels-start .ui-search-box:not(.ui-search-box-label-top), .ui-search-box.ui-search-box-label-start).ui-search-box-width-small { inline-size:var(--percentage-full); grid-template-columns:var(--form-label-width) minmax(0,min(var(--percentage-s), 100% - var(--form-label-width) - var(--gap-toolbar))); }
        :is(.ui-labels-start .ui-search-box:not(.ui-search-box-label-top), .ui-search-box.ui-search-box-label-start).ui-search-box-width-medium { inline-size:var(--percentage-full); grid-template-columns:var(--form-label-width) minmax(0,min(var(--percentage-m), 100% - var(--form-label-width) - var(--gap-toolbar))); }
        :is(.ui-labels-start .ui-search-box:not(.ui-search-box-label-top), .ui-search-box.ui-search-box-label-start).ui-search-box-width-large { inline-size:var(--percentage-full); grid-template-columns:var(--form-label-width) minmax(0,min(var(--percentage-l), 100% - var(--form-label-width) - var(--gap-toolbar))); }
        :is(.ui-labels-start .ui-search-box:not(.ui-search-box-label-top), .ui-search-box.ui-search-box-label-start) > * { grid-column:2; }
        :is(.ui-labels-start .ui-search-box:not(.ui-search-box-label-top), .ui-search-box.ui-search-box-label-start) > .ui-search-box-label { grid-column:1; float:inline-start; margin:0; align-self:center; }
    }
}
