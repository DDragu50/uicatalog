{
  "name": "ui-catalog",
  "private": true,
  "type": "module",
  "description": "UI Catalog components (plain JavaScript, no build step) and their quality tools. The components need nothing from this file; it only runs the checks and tests.",
  "scripts": {
    "check": "node tools/check.mjs",
    "coverage": "node tools/coverage.mjs",
    "llms": "node tools/llms.mjs",
    "test": "node tools/contract.mjs",
    "test:components": "node tools/component-tests.mjs",
    "integrity:save": "node tools/integrity.mjs save",
    "integrity:verify": "node tools/integrity.mjs verify",
    "integrity:restore": "node tools/integrity.mjs restore",
    "status": "node tools/release.mjs --status",
    "release": "node tools/release.mjs",
    "gallery": "node tools/gallery.mjs",
    "gallery:check": "node tools/gallery-check.mjs",
    "starter": "node tools/gallery.mjs starter"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  }
}
